{
  "name": "crypto-snipe-bot",
  "version": "1.0.0",
  "main": "dist/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/main.ts",
    "test": "vitest run --project unit --project integration --reporter=verbose",
    "test:unit": "vitest run --project unit --reporter=verbose",
    "test:integration": "vitest run --project integration --reporter=verbose",
    "test:fork": "vitest run --project fork --reporter=verbose",
    "test:all": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage --project unit --project integration --reporter=verbose",
    "backup:state": "ts-node scripts/backup-state.ts",
    "baselines:capture": "ts-node scripts/capture-baselines.ts",
    "preflight": "ts-node scripts/preflight.ts",
    "pause": "ts-node scripts/pause.ts",
    "resume": "ts-node scripts/resume.ts",
    "db:init": "ts-node scripts/db-init.ts",
    "check:vi-mock": "ts-node scripts/check-vi-mock-paths.ts"
  },
  "dependencies": {
    "@flashbots/ethers-provider-bundle": "1.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/express": "^5.0.6",
    "axios": "1.10.0",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "17.2.0",
    "ethers": "6.16.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "telegram": "2.26.22",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^4.3.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "chai": "4.3.10",
    "eslint": "^9.39.4",
    "hardhat": "2.26.0",
    "hardhat-gas-reporter": "^2.3.0",
    "pino-pretty": "^13.1.3",
    "solidity-coverage": "^0.8.17",
    "ts-node": "10.9.2",
    "typechain": "^8.3.2",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.1"
  }
}
