# Crypto Snipe Bot - Environment Variables
# Copy this file to .env and fill in your values
# Required vars are marked [REQUIRED], optional vars are marked [OPTIONAL]

# --- Wallet ---
PRIVATE_KEY=           # [REQUIRED] Wallet private key for signing transactions

# --- Network ---
NETWORK=sepolia        # [OPTIONAL] Target network: sepolia (default), mainnet
ALCHEMY_URL=           # [REQUIRED] Alchemy RPC endpoint URL (must match NETWORK)

# --- Flashbots ---
FLASHBOTS_AUTH_KEY=    # [REQUIRED] Flashbots authentication signing key (separate from wallet key)

# --- Telegram Bot (notifications) ---
TELEGRAM_BOT_TOKEN=    # [REQUIRED] Telegram bot token from @BotFather
TELEGRAM_CHAT_ID=      # [REQUIRED] Telegram chat ID for alert messages

# --- Telegram Listener (alpha signals) ---
TELEGRAM_API_ID=       # [REQUIRED] Telegram API ID from my.telegram.org
TELEGRAM_API_HASH=     # [REQUIRED] Telegram API hash from my.telegram.org
TELEGRAM_SESSION=      # [REQUIRED] Telegram session string (run auth.ts to generate)

# --- Telegram Whitelist (access control) ---
TELEGRAM_ALLOWED_SENDERS=    # [OPTIONAL] Comma-separated allowed sender IDs (empty = allow all)
TELEGRAM_ALLOWED_CHANNELS=   # [OPTIONAL] Comma-separated allowed channel/group IDs (empty = allow all)

# --- Logging (optional) ---
LOG_LEVEL=info               # [OPTIONAL] debug, info, warn, error (default: info)

# --- Database (optional) ---
DB_PATH=./data/bot.db        # [OPTIONAL] SQLite database path (default: ./data/bot.db)
