# Crypto Snipe Bot - Environment Variables
# Copy this file to .env and fill in your values
# Required vars are marked [REQUIRED], optional vars are marked [OPTIONAL]

# === Wallet ===
PRIVATE_KEY=your_wallet_private_key    # [REQUIRED] Wallet private key for signing transactions

# === Multi-Chain Configuration ===
# Comma-separated chain names to enable: eth, bsc, base, arb
ENABLED_CHAINS=eth                     # [OPTIONAL] Default: eth (Ethereum only)

# === Ethereum (Chain ID: 1) ===
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY   # [OPTIONAL] Required if eth enabled
ETH_WS_URL=wss://eth-mainnet.ws.alchemy.com/v2/YOUR_KEY     # [OPTIONAL] WebSocket RPC for event detection
ETH_SNIPE_AMOUNT=0.01                 # [OPTIONAL] ETH per trade (default: 0.01)
ETH_MAX_CAPITAL=1.0                   # [OPTIONAL] Max ETH deployment (default: 1.0)

# === BSC (Chain ID: 56) ===
BSC_RPC_URL=https://bsc-dataseed.binance.org/               # [OPTIONAL] Required if bsc enabled
BSC_WS_URL=wss://bsc-ws-node.nariox.org                     # [OPTIONAL] WebSocket RPC for event detection
BSC_SNIPE_AMOUNT=0.05                 # [OPTIONAL] BNB per trade (default: 0.05)
BSC_MAX_CAPITAL=5.0                   # [OPTIONAL] Max BNB deployment (default: 5.0)

# === Base (Chain ID: 8453) ===
BASE_RPC_URL=https://mainnet.base.org                       # [OPTIONAL] Required if base enabled
BASE_WS_URL=                          # [OPTIONAL] WebSocket RPC for event detection
BASE_SNIPE_AMOUNT=0.005               # [OPTIONAL] ETH per trade on Base (default: 0.005)
BASE_MAX_CAPITAL=0.5                  # [OPTIONAL] Max ETH deployment on Base (default: 0.5)

# === Arbitrum (Chain ID: 42161) ===
ARB_RPC_URL=https://arb1.arbitrum.io/rpc                    # [OPTIONAL] Required if arb enabled
ARB_WS_URL=                           # [OPTIONAL] WebSocket RPC for event detection
ARB_SNIPE_AMOUNT=0.005               # [OPTIONAL] ETH per trade on Arbitrum (default: 0.005)
ARB_MAX_CAPITAL=0.5                  # [OPTIONAL] Max ETH deployment on Arbitrum (default: 0.5)

# === MEV Protection ===
FLASHBOTS_AUTH_KEY=your_flashbots_auth_signing_key           # [OPTIONAL] Flashbots auth key (required when eth chain enabled)
BLOXROUTE_AUTH_HEADER=your_bloxroute_authorization_header    # [OPTIONAL] bloXroute auth header (BSC MEV protection)

# === Telegram Bot (notifications) ===
TELEGRAM_BOT_TOKEN=your_bot_token     # [REQUIRED] Telegram bot token from @BotFather
TELEGRAM_CHAT_ID=your_chat_id         # [REQUIRED] Telegram chat ID for alert messages

# === Telegram Listener (alpha signals) ===
TELEGRAM_API_ID=your_api_id           # [REQUIRED] Telegram API ID from my.telegram.org
TELEGRAM_API_HASH=your_api_hash       # [REQUIRED] Telegram API hash from my.telegram.org
TELEGRAM_SESSION=your_session_string   # [REQUIRED] Telegram session string (generate manually using telegram package's StringSession)

# === Telegram Whitelist (access control) ===
TELEGRAM_ALLOWED_SENDERS=             # [OPTIONAL] Comma-separated allowed sender IDs (empty = allow all)
TELEGRAM_ALLOWED_CHANNELS=            # [OPTIONAL] Comma-separated allowed channel/group IDs (empty = allow all)

# === Legacy (backward compat, use ETH_RPC_URL instead) ===
ALCHEMY_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY   # [REQUIRED] Falls back if ETH_RPC_URL not set
NETWORK=mainnet                       # [OPTIONAL] Legacy network selector: sepolia, mainnet (default: sepolia)

# === Risk Management ===
MAX_OPEN_POSITIONS=10                 # [OPTIONAL] Max concurrent open positions across all chains (default: 10)
MAX_TOTAL_EXPOSURE=10.0               # [OPTIONAL] Max total native currency deployed across all chains (default: 10.0)
                                      #            NOTE: Sums raw native amounts across chains (ETH + BNB). Set with awareness of mixed denominations.
DAILY_LOSS_PCT=10                     # [OPTIONAL] Daily loss limit as % of per-chain maxCapital (default: 10). Uses rolling 24h window, auto-resumes.
SNIPE_COOLDOWN_MS=30000               # [OPTIONAL] Milliseconds between snipes per chain (default: 30000). Cross-chain snipes are independent.
MAX_POSITION_SIZE=                    # [OPTIONAL] Hard cap on native currency per snipe (default: uses per-chain snipeAmount). Leave empty to use chain defaults.

# === Exit Strategy ===
TRAILING_STOP_PCT=15                  # [OPTIONAL] Trailing stop pullback % from peak (default: 15). Active at >=2x.
TRAILING_MIN_PCT=5                    # [OPTIONAL] Minimum trailing stop % after volatility/urgency adjustment (default: 5)
TRAILING_MAX_PCT=40                   # [OPTIONAL] Maximum trailing stop % after volatility adjustment (default: 40)
PARTIAL_SELL_TARGETS=                 # [OPTIONAL] Partial sell tiers, e.g. "2x:50,5x:25" (default: empty = no partial sells)
STOP_LOSS_PCT=25                      # [OPTIONAL] Fixed stop-loss % below entry, active before trailing activates at 2x (default: 25)

# === Dashboard Configuration (Phase 8) ===
DASHBOARD_API_KEY=your-secret-dashboard-api-key-here   # [REQUIRED] API key for dashboard login (set a strong random string)
DASHBOARD_PORT=8080                   # [OPTIONAL] Dashboard API server port (default: 8080)
DASHBOARD_HOST=127.0.0.1              # [OPTIONAL] Dashboard bind address (default: 127.0.0.1)
                                      # Set DASHBOARD_HOST=0.0.0.0 for remote access (use with caution)
DASHBOARD_ALLOWED_ORIGINS=            # [OPTIONAL] Comma-separated EXTRA browser origins allowed to call the API (CORS).
                                      # LEAVE EMPTY for the default local dashboard: the SPA served by the bot at
                                      # http://DASHBOARD_HOST:DASHBOARD_PORT is same-origin and works without this.
                                      # ONLY set it to open the dashboard from a DIFFERENT origin (remote host or a
                                      # separate dev server), e.g. https://dashboard.example.com,http://localhost:5173
DASHBOARD_TRUST_PROXY_PROTO=          # [OPTIONAL] Set to 1 ONLY behind a TLS-terminating reverse proxy (https ends at
                                      # the proxy, plain http forwarded to the bot). Trusts X-Forwarded-Proto so the
                                      # CORS same-origin check sees the browser's https scheme, not the http proxy->bot
                                      # hop. WITHOUT it, same-origin dashboard login behind a TLS proxy is rejected (403)
                                      # unless you add the https origin to DASHBOARD_ALLOWED_ORIGINS above. Default off =
                                      # scheme read from the real socket. Does NOT enable Express `trust proxy` or trust
                                      # any other forwarded header (e.g. X-Forwarded-For).

# === General ===
LOG_LEVEL=info                        # [OPTIONAL] debug, info, warn, error (default: info)
DB_PATH=./data/bot.db                 # [OPTIONAL] SQLite database path (default: ./data/bot.db)

# === Phase 18 — HoneypotChecker on-chain dispatch (HONEY-03..HONEY-05) ===
# Per iter-2 Blocker #3, the canonical deployed-address defaults live in
# src/chainRegistry.ts CHAIN_TEMPLATES[<chain>].defaultHoneypotCheckerAddress.
# The env vars below are OPERATOR OVERRIDES — they override the literal default
# without requiring a redeploy + recompile. Leave them empty in normal operation.
ETH_HONEYPOT_CHECKER_ADDRESS=         # [OPTIONAL] Override eth default (committed: 0x8243dBeA5caD296B9e72a6ed557D7E0fEBee13eD)
BSC_HONEYPOT_CHECKER_ADDRESS=         # [OPTIONAL] Override bsc default (default: null; populated by plan 18-08)
BASE_HONEYPOT_CHECKER_ADDRESS=        # [OPTIONAL] Override base default (default: null; populated by plan 18-08)
ARB_HONEYPOT_CHECKER_ADDRESS=         # [OPTIONAL] Override arb default (default: null; populated by plan 18-08)

# === Phase 18 — Deploy operator key (D-DEPLOY-KEY: SEPARATE from bot's PRIVATE_KEY) ===
# Set during deploy window only; rotate out after deploy succeeds. The bot wallet
# (PRIVATE_KEY) intentionally has NO deploy authority on any production chain.
DEPLOY_PRIVATE_KEY=                   # [REQUIRED during deploy] Operator-rotated fresh deploy wallet key

# === Phase 18 — Block-explorer API keys (Etherscan v2 unifies all chains) ===
# As of May 2025, Etherscan deprecated the v1 multi-key model. A SINGLE
# ETHERSCAN_API_KEY now works for mainnet, BSC, Base, Arbitrum, and Sepolia.
# The BSCSCAN/BASESCAN/ARBISCAN slots below are kept for backward-compat ONLY
# and have no effect on hardhat-verify@2.1+; they may be deleted safely.
ETHERSCAN_API_KEY=                    # [REQUIRED during verify] https://etherscan.io/myapikey — works for ALL chains under v2
BSCSCAN_API_KEY=                      # [DEPRECATED — Etherscan v2 unifies; unused by hardhat-verify@2.1+]
BASESCAN_API_KEY=                     # [DEPRECATED — Etherscan v2 unifies; unused by hardhat-verify@2.1+]
ARBISCAN_API_KEY=                     # [DEPRECATED — Etherscan v2 unifies; unused by hardhat-verify@2.1+]

# === Phase 18 — Sepolia rehearsal RPC (testnet deploy practice only) ===
SEPOLIA_RPC_URL=                      # [OPTIONAL] Alchemy/Infura Sepolia URL for testnet rehearsal deploys

# === Phase 18 — Per-chain tax thresholds (D-TAX-THRESHOLDS; 1000 bps = 10%) ===
# Fail-loud validated in [0, 10000]. Default 1000 per chainRegistry template.
ETH_MAX_BUY_TAX_BPS=1000              # [OPTIONAL] Max buy tax bps for ETH (default: 1000)
ETH_MAX_SELL_TAX_BPS=1000             # [OPTIONAL] Max sell tax bps for ETH (default: 1000)
BSC_MAX_BUY_TAX_BPS=1000              # [OPTIONAL] Max buy tax bps for BSC (default: 1000)
BSC_MAX_SELL_TAX_BPS=1000             # [OPTIONAL] Max sell tax bps for BSC (default: 1000)
BASE_MAX_BUY_TAX_BPS=1000             # [OPTIONAL] Max buy tax bps for Base (default: 1000)
BASE_MAX_SELL_TAX_BPS=1000            # [OPTIONAL] Max sell tax bps for Base (default: 1000)
ARB_MAX_BUY_TAX_BPS=1000              # [OPTIONAL] Max buy tax bps for Arb (default: 1000)
ARB_MAX_SELL_TAX_BPS=1000             # [OPTIONAL] Max sell tax bps for Arb (default: 1000)

# ---- Anti-Rug Runtime Monitoring (Phase 19) ----
# Per-chain anti-rug tuning thresholds + locker allowlists. All fields default
# to safe values (dry-run, conservative thresholds); flip ANTIRUG_LIVE_EXECUTE
# to true ONLY after 7-day dry-run review with 0 confirmed false positives.
# See docs/operations/anti-rug-rollout.md (Plan 19-08) for the operator
# handoff protocol.

# ETH anti-rug — dry-run by default; see docs/operations/anti-rug-rollout.md for live-flip protocol
ETH_ANTIRUG_LIVE_EXECUTE=false            # [OPTIONAL] dry-run by default (true → live exit; flip only after 7-day review per D-LIVE-GATE)
ETH_ANTIRUG_LP_REMOVAL_PCT=50             # [OPTIONAL] signal 1: % of LP removed vs baseline that trips threshold (default: 50)
ETH_ANTIRUG_CONFIRM_BLOCKS=1              # [OPTIONAL] confirm-after-N-blocks before exit fires (default: 1)
ETH_ANTIRUG_CIRCUIT_BREAKER_TRIGGERS=3    # [OPTIONAL] CB trips after N anti-rug exits within window (default: 3)
ETH_ANTIRUG_CIRCUIT_BREAKER_WINDOW_HOURS=1 # [OPTIONAL] CB rolling window in hours (default: 1)
ETH_ANTIRUG_GAS_MULTIPLIER=2.0            # [OPTIONAL] multiplier on EIP-1559 fields when reason=anti-rug (default: 2.0)
ETH_ANTIRUG_BACKFILL_CAP_BLOCKS=10        # [OPTIONAL] max blocks per getLogs call; ETH=10 (Alchemy free-tier safe per 19-RESEARCH.md CRITICAL #1)
ETH_ANTIRUG_MAX_BACKFILL_BLOCKS=7200      # [OPTIONAL] hard ceiling; gap > this fires [GAP DETECTED] alert + manual review (default: 7200 = ~1 day on ETH)
ETH_ANTIRUG_ALLOWLIST_EXTRA=              # [OPTIONAL] DEPRECATED unified V2+V3 overlay — prefer per-pool-type ALLOWLIST_EXTRA_V2 / ALLOWLIST_EXTRA_V3 below (deprecation warn fires at startup when set)
ETH_ANTIRUG_ALLOWLIST_EXTRA_V2=           # [OPTIONAL] comma-separated V2-only locker checksummed addresses (preferred over the deprecated unified ALLOWLIST_EXTRA)
ETH_ANTIRUG_ALLOWLIST_EXTRA_V3=           # [OPTIONAL] comma-separated V3-only locker checksummed addresses (preferred over the deprecated unified ALLOWLIST_EXTRA)

# BSC anti-rug — dry-run by default; see docs/operations/anti-rug-rollout.md
BSC_ANTIRUG_LIVE_EXECUTE=false            # [OPTIONAL] dry-run by default (true → live exit; flip only after 7-day review per D-LIVE-GATE)
BSC_ANTIRUG_LP_REMOVAL_PCT=50             # [OPTIONAL] signal 1: % of LP removed vs baseline that trips threshold (default: 50)
BSC_ANTIRUG_CONFIRM_BLOCKS=1              # [OPTIONAL] confirm-after-N-blocks before exit fires (default: 1)
BSC_ANTIRUG_CIRCUIT_BREAKER_TRIGGERS=3    # [OPTIONAL] CB trips after N anti-rug exits within window (default: 3)
BSC_ANTIRUG_CIRCUIT_BREAKER_WINDOW_HOURS=1 # [OPTIONAL] CB rolling window in hours (default: 1)
BSC_ANTIRUG_GAS_MULTIPLIER=2.0            # [OPTIONAL] multiplier on EIP-1559 fields when reason=anti-rug (default: 2.0)
BSC_ANTIRUG_BACKFILL_CAP_BLOCKS=500       # [OPTIONAL] max blocks per getLogs call; BSC=500 conservative for public RPC / Chainstack
BSC_ANTIRUG_MAX_BACKFILL_BLOCKS=7200      # [OPTIONAL] hard ceiling; gap > this fires [GAP DETECTED] alert + manual review (default: 7200)
BSC_ANTIRUG_ALLOWLIST_EXTRA=              # [OPTIONAL] DEPRECATED unified V2+V3 overlay — prefer per-pool-type ALLOWLIST_EXTRA_V2 / ALLOWLIST_EXTRA_V3 below (deprecation warn fires at startup when set)
BSC_ANTIRUG_ALLOWLIST_EXTRA_V2=           # [OPTIONAL] comma-separated V2-only locker checksummed addresses (preferred over the deprecated unified ALLOWLIST_EXTRA)
BSC_ANTIRUG_ALLOWLIST_EXTRA_V3=           # [OPTIONAL] comma-separated V3-only locker checksummed addresses (preferred over the deprecated unified ALLOWLIST_EXTRA)

# Base anti-rug — dry-run by default; see docs/operations/anti-rug-rollout.md
BASE_ANTIRUG_LIVE_EXECUTE=false           # [OPTIONAL] dry-run by default (true → live exit; flip only after 7-day review per D-LIVE-GATE)
BASE_ANTIRUG_LP_REMOVAL_PCT=50            # [OPTIONAL] signal 1: % of LP removed vs baseline that trips threshold (default: 50)
BASE_ANTIRUG_CONFIRM_BLOCKS=1             # [OPTIONAL] confirm-after-N-blocks before exit fires (default: 1)
BASE_ANTIRUG_CIRCUIT_BREAKER_TRIGGERS=3   # [OPTIONAL] CB trips after N anti-rug exits within window (default: 3)
BASE_ANTIRUG_CIRCUIT_BREAKER_WINDOW_HOURS=1 # [OPTIONAL] CB rolling window in hours (default: 1)
BASE_ANTIRUG_GAS_MULTIPLIER=2.0           # [OPTIONAL] multiplier on EIP-1559 fields when reason=anti-rug (default: 2.0)
BASE_ANTIRUG_BACKFILL_CAP_BLOCKS=500      # [OPTIONAL] max blocks per getLogs call; Base=500 conservative for public RPC
BASE_ANTIRUG_MAX_BACKFILL_BLOCKS=7200     # [OPTIONAL] hard ceiling; gap > this fires [GAP DETECTED] alert + manual review (default: 7200)
BASE_ANTIRUG_ALLOWLIST_EXTRA=             # [OPTIONAL] DEPRECATED unified V2+V3 overlay — prefer per-pool-type ALLOWLIST_EXTRA_V2 / ALLOWLIST_EXTRA_V3 below (deprecation warn fires at startup when set)
BASE_ANTIRUG_ALLOWLIST_EXTRA_V2=          # [OPTIONAL] comma-separated V2-only locker checksummed addresses (preferred over the deprecated unified ALLOWLIST_EXTRA)
BASE_ANTIRUG_ALLOWLIST_EXTRA_V3=          # [OPTIONAL] comma-separated V3-only locker checksummed addresses (preferred over the deprecated unified ALLOWLIST_EXTRA)

# Arbitrum anti-rug — dry-run by default; see docs/operations/anti-rug-rollout.md
ARB_ANTIRUG_LIVE_EXECUTE=false            # [OPTIONAL] dry-run by default (true → live exit; flip only after 7-day review per D-LIVE-GATE)
ARB_ANTIRUG_LP_REMOVAL_PCT=50             # [OPTIONAL] signal 1: % of LP removed vs baseline that trips threshold (default: 50)
ARB_ANTIRUG_CONFIRM_BLOCKS=1              # [OPTIONAL] confirm-after-N-blocks before exit fires (default: 1)
ARB_ANTIRUG_CIRCUIT_BREAKER_TRIGGERS=3    # [OPTIONAL] CB trips after N anti-rug exits within window (default: 3)
ARB_ANTIRUG_CIRCUIT_BREAKER_WINDOW_HOURS=1 # [OPTIONAL] CB rolling window in hours (default: 1)
ARB_ANTIRUG_GAS_MULTIPLIER=2.0            # [OPTIONAL] multiplier on EIP-1559 fields when reason=anti-rug (default: 2.0)
ARB_ANTIRUG_BACKFILL_CAP_BLOCKS=500       # [OPTIONAL] max blocks per getLogs call; Arb=500 conservative for public RPC
ARB_ANTIRUG_MAX_BACKFILL_BLOCKS=7200      # [OPTIONAL] hard ceiling; gap > this fires [GAP DETECTED] alert + manual review (default: 7200)
ARB_ANTIRUG_ALLOWLIST_EXTRA=              # [OPTIONAL] DEPRECATED unified V2+V3 overlay — prefer per-pool-type ALLOWLIST_EXTRA_V2 / ALLOWLIST_EXTRA_V3 below (deprecation warn fires at startup when set)
ARB_ANTIRUG_ALLOWLIST_EXTRA_V2=           # [OPTIONAL] comma-separated V2-only locker checksummed addresses (preferred over the deprecated unified ALLOWLIST_EXTRA)
ARB_ANTIRUG_ALLOWLIST_EXTRA_V3=           # [OPTIONAL] comma-separated V3-only locker checksummed addresses (preferred over the deprecated unified ALLOWLIST_EXTRA)

# ---- Going-Live Ops Hardening (Phase 20) ----
# Per D-ENV-EXAMPLE [USER-BINDING]: every Phase 20 env var with default + 1-line
# inline description. All optional with safe defaults. The bot refuses to start
# in any inconsistent state (D-ROLLBACK: no SKIP_PREFLIGHT escape hatch).

# Per-chain gas buffers (native units) for the preflight wallet-balance floor.
# floor = parseEther(snipeAmount) × MAX_OPEN_POSITIONS + parseEther(gasBuffer).
# Defaults chosen for safety on the funded mainnet wallet (~0.0124 ETH).
ETH_GAS_BUFFER=0.005                  # [OPTIONAL] preflight floor gas buffer for ETH (native units, default: 0.005)
BSC_GAS_BUFFER=0.003                  # [OPTIONAL] preflight floor gas buffer for BSC (native units, default: 0.003)
BASE_GAS_BUFFER=0.0005                # [OPTIONAL] preflight floor gas buffer for Base (native units, default: 0.0005)
ARB_GAS_BUFFER=0.0005                 # [OPTIONAL] preflight floor gas buffer for Arbitrum (native units, default: 0.0005)

# Per-chain RPC block-age tolerance (seconds). Tip stale beyond this fires
# FATAL non-zero exit. Defaults ~5x chain block-time per RESEARCH OQ4.
ETH_BLOCK_AGE_TOLERANCE_SEC=300       # [OPTIONAL] preflight block-age tolerance for ETH in seconds (default: 300)
BSC_BLOCK_AGE_TOLERANCE_SEC=60        # [OPTIONAL] preflight block-age tolerance for BSC in seconds (default: 60)
BASE_BLOCK_AGE_TOLERANCE_SEC=30       # [OPTIONAL] preflight block-age tolerance for Base in seconds (default: 30)
ARB_BLOCK_AGE_TOLERANCE_SEC=30        # [OPTIONAL] preflight block-age tolerance for Arbitrum in seconds (default: 30)

# Mid-run wallet-balance re-check interval per D-MID-RUN-CHECK.
MID_RUN_CHECK_INTERVAL_SEC=300        # [OPTIONAL] periodic mid-run wallet re-check interval in seconds (default: 300 = 5 min)

# Stale-data warning thresholds per D-STALE-THRESHOLDS.
STALE_WARN_SEC=120                    # [OPTIONAL] stale-position warn threshold in seconds (default: 120 = 2 min)
STALE_ERROR_SEC=600                   # [OPTIONAL] stale-position error threshold in seconds (default: 600 = 10 min)

# Dashboard URL - consumed by the pause/resume operator CLI scripts.
DASHBOARD_URL=http://127.0.0.1:8080   # [OPTIONAL] dashboard URL for the pause/resume CLI (default: derived from DASHBOARD_HOST:DASHBOARD_PORT = http://127.0.0.1:8080)

# === Test / Capture Safety (Phase 21) ===
# Per D-ENV-EXAMPLE [USER-BINDING]: each new env var lands here with default +
# 1-line description. All optional; all default to the SAFE/guard-active state.
# The automated test suite must NEVER load the prod PRIVATE_KEY above
# (D-TEST-WALLET-FORKONLY) and must NEVER transact on real mainnet
# (D-GATE-BOTH-LAYERS). CI never sets ALLOW_REAL_MAINNET.
ALLOW_REAL_MAINNET=                    # [OPTIONAL] Test-only tripwire. Set to 1 ONLY to deliberately run a real-mainnet (chainId 1) fork test. NEVER set in CI. Default unset = guard active.
TEST_WALLET_PRIVATE_KEY=              # [OPTIONAL] Fork-only throwaway key (zero real ETH) for fork-impersonation signing. NEVER reuse PRIVATE_KEY (prod wallet).
CAPTURE_ARCHIVE_RPC_URL=             # [OPTIONAL] Archive RPC for scripts/capture-launch.ts historical getLogs. Falls back to ALCHEMY_URL if unset.
