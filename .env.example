# Crypto Snipe Bot - Environment Variables
# Copy this file to .env and fill in your values
# Required vars are marked [REQUIRED], optional vars are marked [OPTIONAL]

# === Wallet ===
PRIVATE_KEY=your_wallet_private_key    # [REQUIRED] Wallet private key for signing transactions

# === Multi-Chain Configuration ===
# Comma-separated chain names to enable: eth, bsc, base, arb
ENABLED_CHAINS=eth                     # [OPTIONAL] Default: eth (Ethereum only)

# === Ethereum (Chain ID: 1) ===
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY   # [OPTIONAL] Required if eth enabled
ETH_WS_URL=wss://eth-mainnet.ws.alchemy.com/v2/YOUR_KEY     # [OPTIONAL] WebSocket RPC for event detection
ETH_SNIPE_AMOUNT=0.01                 # [OPTIONAL] ETH per trade (default: 0.01)
ETH_MAX_CAPITAL=1.0                   # [OPTIONAL] Max ETH deployment (default: 1.0)

# === BSC (Chain ID: 56) ===
BSC_RPC_URL=https://bsc-dataseed.binance.org/               # [OPTIONAL] Required if bsc enabled
BSC_WS_URL=wss://bsc-ws-node.nariox.org                     # [OPTIONAL] WebSocket RPC for event detection
BSC_SNIPE_AMOUNT=0.05                 # [OPTIONAL] BNB per trade (default: 0.05)
BSC_MAX_CAPITAL=5.0                   # [OPTIONAL] Max BNB deployment (default: 5.0)

# === Base (Chain ID: 8453) ===
BASE_RPC_URL=https://mainnet.base.org                       # [OPTIONAL] Required if base enabled
BASE_WS_URL=                          # [OPTIONAL] WebSocket RPC for event detection
BASE_SNIPE_AMOUNT=0.005               # [OPTIONAL] ETH per trade on Base (default: 0.005)
BASE_MAX_CAPITAL=0.5                  # [OPTIONAL] Max ETH deployment on Base (default: 0.5)

# === Arbitrum (Chain ID: 42161) ===
ARB_RPC_URL=https://arb1.arbitrum.io/rpc                    # [OPTIONAL] Required if arb enabled
ARB_WS_URL=                           # [OPTIONAL] WebSocket RPC for event detection
ARB_SNIPE_AMOUNT=0.005               # [OPTIONAL] ETH per trade on Arbitrum (default: 0.005)
ARB_MAX_CAPITAL=0.5                  # [OPTIONAL] Max ETH deployment on Arbitrum (default: 0.5)

# === MEV Protection ===
FLASHBOTS_AUTH_KEY=your_flashbots_auth_signing_key           # [REQUIRED] Flashbots auth key (ETH MEV protection)
BLOXROUTE_AUTH_HEADER=your_bloxroute_authorization_header    # [OPTIONAL] bloXroute auth header (BSC MEV protection)

# === Telegram Bot (notifications) ===
TELEGRAM_BOT_TOKEN=your_bot_token     # [REQUIRED] Telegram bot token from @BotFather
TELEGRAM_CHAT_ID=your_chat_id         # [REQUIRED] Telegram chat ID for alert messages

# === Telegram Listener (alpha signals) ===
TELEGRAM_API_ID=your_api_id           # [REQUIRED] Telegram API ID from my.telegram.org
TELEGRAM_API_HASH=your_api_hash       # [REQUIRED] Telegram API hash from my.telegram.org
TELEGRAM_SESSION=your_session_string   # [REQUIRED] Telegram session string (run auth.ts to generate)

# === Telegram Whitelist (access control) ===
TELEGRAM_ALLOWED_SENDERS=             # [OPTIONAL] Comma-separated allowed sender IDs (empty = allow all)
TELEGRAM_ALLOWED_CHANNELS=            # [OPTIONAL] Comma-separated allowed channel/group IDs (empty = allow all)

# === Legacy (backward compat, use ETH_RPC_URL instead) ===
ALCHEMY_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY   # [REQUIRED] Falls back if ETH_RPC_URL not set
NETWORK=mainnet                       # [OPTIONAL] Legacy network selector: sepolia, mainnet (default: sepolia)

# === General ===
LOG_LEVEL=info                        # [OPTIONAL] debug, info, warn, error (default: info)
DB_PATH=./data/bot.db                 # [OPTIONAL] SQLite database path (default: ./data/bot.db)
