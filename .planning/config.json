{
  "mode": "yolo",
  "granularity": "fine",
  "parallelization": true,
  "commit_docs": true,
  "model_profile": "quality",
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": false,
    "nyquist_validation": true,
    "ui_phase": true,
    "ui_safety_gate": true,
    "text_mode": false,
    "research_before_questions": true,
    "skip_discuss": false,
    "use_worktrees": false,
    "_auto_chain_active": false,
    "code_review_depth": "deep",
    "pattern_mapper": true,
    "ai_integration_phase": true,
    "tdd_mode": false,
    "code_review": true,
    "ui_review": true,
    "compact_content": false,
    "subagent_timeout": 900000,
    "node_repair_budget": 3,
    "auto_prune_state": true,
    "max_discuss_passes": 5
  },
  "git": {
    "branching_strategy": "phase",
    "quick_branch_template": null,
    "create_tag": true,
    "base_branch": "main",
    "phase_branch_template": "phase-{phase}-{slug}",
    "milestone_branch_template": "milestone/{milestone}"
  },
  "hooks": {
    "context_warnings": true,
    "workflow_guard": true,
    "secret_read_exempt": [
      "test/.env.test"
    ]
  },
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": true,
    "auto_update": false
  },
  "plan_review": {
    "source_grounding": true
  },
  "planner": {
    "stall_detection_enabled": false
  },
  "context_window": 1000000,
  "brave_search": true,
  "firecrawl": true,
  "exa_search": true,
  "review": {
    "models": {
      "codex": "gpt-6.1-sol",
      "agy": "gemini-4-argon-high"
    },
    "effort": {
      "codex": "xhigh"
    },
    "context_window_tokens": {
      "codex": 500000
    },
    "timeouts": {
      "codex": 3600
    }
  }
}
