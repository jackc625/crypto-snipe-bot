/tmp
/out-tsc

# Dependencies
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/.pnp
.pnp.js

# IDE
.vscode/*
.idea/
*.swp

# Secrets — NEVER commit
.env
.env.*
!.env.example
# Committed SAFE-02 test-rail sentinel env: every value is an inert TEST-SENTINEL (D-02)
!test/.env.test
cookies.txt
*.pem
*.key

# Runtime state
# SQLite database (runtime generated)
data/
.bot-state.json
.bot-state.json.bak
*.bak

# Hardhat
# Hardhat cache (runtime generated)
cache/
artifacts/
# OD-21 (Phase 22, 22-07): Ignition per-future artifacts are tracked deployment state, not build output
!ignition/deployments/*/artifacts/
typechain-types/

# Build output
dist/
build/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Audit tool outputs (Slither / Mythril JSON + raw text)
# Plan 18-05 (HONEY-02): reports/ holds dynamic Slither + Mythril JSON
# plus the local-run solc binary cache used by Mythril on Windows hosts
# (the official mythril/myth Docker image's solc-bin host is dead, so
# operators bind-mount a pre-downloaded solc-vX into /home/mythril/.solcx).
# The directory itself is preserved via the !reports/.gitkeep rule so the
# CI audit jobs always have a place to write to without race-creating it.
reports/*
!reports/.gitkeep

# Agent / tooling local state
.claude/

# OS
.DS_Store
Thumbs.db

# Dashboard source is TypeScript-only (.tsx/.ts).
# .js files in this tree are Vite/TS transpilation artifacts, not hand-written source.
# If a legitimate .js file is ever needed here, use !dashboard/src/path/to/file.js to un-ignore.
dashboard/src/**/*.js

# GSD research fetch cache (local, regenerated)
.planning/research/.cache/

# graphify build output — derived from source, rebuild with /gsd-graphify build.
# graphify-out/ is graphify's raw output; .planning/graphs/ is GSD's copy
# (graph.json, graph.html, GRAPH_REPORT.md, local diff snapshot). Not tracked:
# it churns heavily per rebuild and conflicts across per-phase branches.
graphify-out/
.planning/graphs/
