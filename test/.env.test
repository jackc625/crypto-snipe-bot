# === Calm-gas sell inclusion ===
MEV_SELL_MAX_PRIORITY_FEE_GWEI=25
MEV_SELL_COINBASE_BRIBE_ENABLED=false
EXIT_GATE_SELL_GAS_BUFFER=2.0
MEV_SELL_FALLBACK_ATTEMPTS=2
