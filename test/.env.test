BSC_ANTIRUG_ALLOWLIST_EXTRA=
BSC_ANTIRUG_ALLOWLIST_EXTRA_V2=
BSC_ANTIRUG_ALLOWLIST_EXTRA_V3=

BASE_ANTIRUG_LIVE_EXECUTE=false
BASE_ANTIRUG_LP_REMOVAL_PCT=50
BASE_ANTIRUG_CONFIRM_BLOCKS=1
BASE_ANTIRUG_CIRCUIT_BREAKER_TRIGGERS=3
BASE_ANTIRUG_CIRCUIT_BREAKER_WINDOW_HOURS=1
BASE_ANTIRUG_GAS_MULTIPLIER=2.0
BASE_ANTIRUG_BACKFILL_CAP_BLOCKS=500
BASE_ANTIRUG_MAX_BACKFILL_BLOCKS=7200
BASE_ANTIRUG_ALLOWLIST_EXTRA=
BASE_ANTIRUG_ALLOWLIST_EXTRA_V2=
BASE_ANTIRUG_ALLOWLIST_EXTRA_V3=

ARB_ANTIRUG_LIVE_EXECUTE=false
ARB_ANTIRUG_LP_REMOVAL_PCT=50
ARB_ANTIRUG_CONFIRM_BLOCKS=1
ARB_ANTIRUG_CIRCUIT_BREAKER_TRIGGERS=3
ARB_ANTIRUG_CIRCUIT_BREAKER_WINDOW_HOURS=1
ARB_ANTIRUG_GAS_MULTIPLIER=2.0
ARB_ANTIRUG_BACKFILL_CAP_BLOCKS=500
ARB_ANTIRUG_MAX_BACKFILL_BLOCKS=7200
ARB_ANTIRUG_ALLOWLIST_EXTRA=
ARB_ANTIRUG_ALLOWLIST_EXTRA_V2=
ARB_ANTIRUG_ALLOWLIST_EXTRA_V3=

# === Going-live ops hardening ===
ETH_GAS_BUFFER=0.005
BSC_GAS_BUFFER=0.003
BASE_GAS_BUFFER=0.0005
ARB_GAS_BUFFER=0.0005
ETH_BLOCK_AGE_TOLERANCE_SEC=300
BSC_BLOCK_AGE_TOLERANCE_SEC=60
BASE_BLOCK_AGE_TOLERANCE_SEC=30
ARB_BLOCK_AGE_TOLERANCE_SEC=30
MID_RUN_CHECK_INTERVAL_SEC=300
STALE_WARN_SEC=120
STALE_ERROR_SEC=600
DASHBOARD_URL=http://127.0.0.1:1

# === MEV inclusion-reconciliation ===
MEV_CONFIRM_WINDOW_MS=45000
MEV_CONFIRM_POLL_MS=4000
MEV_MAX_PRIORITY_FEE_GWEI=5
MEV_PRIORITY_FEE_STEP_GWEI=1
