# === Failed-exit position protection ===
EXIT_DUST_THRESHOLD_BPS=1
EXIT_ROUTINE_MAX_FAILURES=5

# === Calm-gas BUY inclusion ===
MEV_BUILDERS=flashbots,f1b.io,rsync,beaverbuild.org,builder0x69,Titan,EigenPhi,Gambit Labs,payload,Loki,JetBuilder,tbuilder,bobthebuilder,BTCS,bloXroute,Blockbeelder,Quasar,Eureka,Bombora
MEV_BUY_TARGET_BLOCKS=3
MEV_BUY_MAX_PRIORITY_FEE_GWEI=25
DELIBERATE_BUY_PRIVATE_ATTEMPTS=2
DELIBERATE_BUY_SLIPPAGE_PCT=5
DELIBERATE_BUY_GAS_BUFFER=2.0
MEV_BUY_COINBASE_BRIBE_ENABLED=false

# === Test / Capture Safety ===
ALLOW_REAL_MAINNET=
